rules_version = '2';

// Cada usuário só acessa os próprios dados:
//   usuarios/{uid}
//   usuarios/{uid}/tarefas/{taskId}
//   usuarios/{uid}/pastas/{folderId}
//   usuarios/{uid}/dados/perfil
// Qualquer outro caminho fica bloqueado.
service cloud.firestore {
  match /databases/{database}/documents {

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    function isOptionalString(data, field, maxSize) {
      return !(field in data) || data[field] == null
        || (data[field] is string && data[field].size() <= maxSize);
    }

    function isOptionalNumber(data, field) {
      return !(field in data) || data[field] == null || data[field] is number;
    }

    function isValidTask(task) {
      return task.name is string
        && task.name.size() > 0 && task.name.size() <= 160
        && isOptionalString(task, 'description', 1000)
        && isOptionalString(task, 'dueDate', 30)
        && isOptionalString(task, 'folderId', 100)
        && (!('priority' in task) || task.priority in ['low', 'medium', 'high'])
        && (!('completed' in task) || task.completed is bool)
        && isOptionalNumber(task, 'criadoEm')
        && isOptionalNumber(task, 'concluidoEm');
    }

    function isValidFolder(folder) {
      return folder.name is string
        && folder.name.size() > 0 && folder.name.size() <= 50
        && (!('color' in folder) || (folder.color is string && folder.color.matches('^#[0-9a-fA-F]{6}$')))
        && isOptionalNumber(folder, 'criadoEm');
    }

    function isValidProfile(profile) {
      return profile.displayName is string
        && profile.displayName.size() > 0 && profile.displayName.size() <= 60
        && isOptionalString(profile, 'photo', 900000);
    }

    match /usuarios/{uid} {
      allow read, write: if isOwner(uid);

      match /tarefas/{taskId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidTask(request.resource.data);
      }

      match /pastas/{folderId} {
        allow read, delete: if isOwner(uid);
        allow create, update: if isOwner(uid) && isValidFolder(request.resource.data);
      }

      match /dados/perfil {
        allow read: if isOwner(uid);
        allow write: if isOwner(uid) && isValidProfile(request.resource.data);
      }
    }
  }
}