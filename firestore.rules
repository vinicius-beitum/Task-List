rules_version = '2';

// Cada usuário só lê e escreve nos PRÓPRIOS dados:
//   usuarios/{uid}                  (nome, e-mail)
//   usuarios/{uid}/tarefas/{id}
//   usuarios/{uid}/pastas/{id}
//   usuarios/{uid}/dados/perfil
// Qualquer outra coisa fica bloqueada.
service cloud.firestore {
  match /databases/{database}/documents {

    function dono(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    match /usuarios/{uid} {
      allow read, write: if dono(uid);
    }

    match /usuarios/{uid}/{documento=**} {
      allow read, write: if dono(uid);
    }
  }
}
